# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/restaurant-db

# JWT secret: use a unique random value of at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# JWT token expiration
JWT_EXPIRATION=7d

# Port (Render sets this automatically)
PORT=3000

# CORS - your Vercel frontend URL (comma-separated for multiple)
CORS_ORIGIN=https://your-frontend-name.vercel.app

# Set to production on your production backend host.
# Production requires MONGODB_URI and JWT_SECRET; demo seeding is disabled.
NODE_ENV=development
